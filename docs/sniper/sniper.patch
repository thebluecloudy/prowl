+  try { r = await sgwFetch(f || fetch, "SignIn/Login", { method: "POST", headers: Object.assign({ "Content-Type": "application/json" }, SGW_HDR), body: JSON.stringify(body) }); }
+  catch (e) { return { error: "ShopGoodwill did not answer. Try again in a minute.", status: 502 }; }
+  const tok = r.j && (r.j.accessToken || r.j.AccessToken || (r.j.data && r.j.data.accessToken));
+  if (r.status === 200 && typeof tok === "string" && tok.length > 20) return { tok: tok };
