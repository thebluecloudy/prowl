+test("no bid when the price is already past the max; failed and signed out on a 401", async () => {
+  let sgw = fakeSgw({ lot: () => lotJson({ currentPrice: 55 }) });
+  let { o } = await queued({}, sgw);
+  await o.alarm();
+  assert.ok(!sgw.calls.some((c) => /PlaceBid/.test(c.url)));
+  assert.equal((await o.s.get("s:123456")).st, "lost");
+
+  sgw = fakeSgw({ bid: () => new Response("", { status: 401 }) });
+  ({ o } = await queued({}, sgw));
+  await o.alarm();
+  const s = await o.s.get("s:123456");
+  assert.equal(s.st, "failed");
