+  await call(w.env, "/snipe/add", { id: "123456", max: 40 }, { f: fakeSgw().f });
+  const o = w.obj(), s = await o.s.get("s:123456");
+  s.end = Date.now() + SNIPE_LEAD_MS + 30; s.fire = s.end - SNIPE_LEAD_MS;
+  await o.s.put("s:123456", s);
+  o.f = (sgw || fakeSgw(over)).f;
+  return { w, o };
+}
