+  return {
+    id: String(j.itemId), title: String(j.title || "").slice(0, 160), img: img ? server + img.split("/").map(encodeURIComponent).join("/") : "",
+    end: isFinite(end) ? end : 0, seller: Number(j.sellerId) || 0, cur: Number(j.currentPrice) || 0, min: Number(j.minimumBid) || 0,
