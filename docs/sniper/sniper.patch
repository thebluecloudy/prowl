+test("after the close: lost when it went past the max, ended otherwise", async () => {
+  const { o } = await queued();
+  await o.alarm();
+  const s = await o.s.get("s:123456");
+  s.end = Date.now() - 100000; await o.s.put("s:123456", s);
+  o.f = fakeSgw({ lot: () => lotJson({ currentPrice: 61, isItemEndTimeExpire: true }) }).f;
+  await o.alarm();
+  let d = await o.s.get("s:123456");
+  assert.equal(d.st, "lost");
+  assert.equal(d.final, 61);
+  d.st = "placed"; await o.s.put("s:123456", d);
+  o.f = fakeSgw({ lot: () => lotJson({ currentPrice: 31, isItemEndTimeExpire: true }) }).f;
+  await o.alarm();
+  d = await o.s.get("s:123456");
+  assert.equal(d.st, "ended");
+  assert.match(d.msg, /Ended at \$31\.00, within your \$40\.00 max/);
+  assert.equal(o.s.alarm, null, "nothing left to wake for");
+});
