+test("the alarm bids the max from the member's token, at the fire time", async () => {
+  const sgw = fakeSgw();
+  const { o } = await queued({}, sgw);
+  const t0 = Date.now(), fire = (await o.s.get("s:123456")).fire;
+  await o.alarm();
+  const bid = sgw.calls.find((c) => /PlaceBid/.test(c.url));
+  assert.ok(bid, "bid placed");
+  assert.ok(Date.now() >= fire - 5 && Date.now() - t0 < 2000);
+  assert.equal(bid.init.headers.Authorization, "Bearer sgw-access-token-abcdefghijklmnop");
+  assert.deepEqual(JSON.parse(bid.init.body), { itemId: 123456, quantity: 1, sellerId: 77, bidAmount: "40.00" });
+  const s = await o.s.get("s:123456");
+  assert.equal(s.st, "placed");
+  assert.match(s.msg, /high bidder/);
+  assert.ok(o.s.alarm >= s.end, "a check after the close is armed");
+});
