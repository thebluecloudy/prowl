+/* ---------- v126: the ShopGoodwill sniper ----------
+   A member (for now only the owner key, while it is tested on real lots) picks a ShopGoodwill auction and a max bid.
+   A few seconds before the close, Prowl places that max as one bid from the member's own ShopGoodwill account.
+   ShopGoodwill has a hard close (no soft-close extension), and it bids for the high bidder up to their max, so one
+   late bid of the max is the whole snipe.
+
+     GET  /snipe                        -> { on, connected, since, snipes: [view] }
+     POST /snipe/connect  { user, pass } -> signs in to ShopGoodwill once; keeps only ShopGoodwill's access token,
+                                           sealed (AES-GCM). The password is never stored, logged or sent anywhere else.
+     POST /snipe/disconnect              -> forgets the token
+     POST /snipe/add      { id, max }    -> queues a snipe on lot <id> for <max> dollars
+     POST /snipe/cancel   { id }         -> takes a queued snipe off
+
+   The timing lives in a Durable Object (binding SNIPER, class Sniper), one per member: its alarm wakes SNIPE_WAKE_MS
+   before the earliest fire time, rechecks the lot (which also opens the connection), waits to the second, then bids.
+   SNIPE_CHECK_MS after the close it reads the final price and says whether the max was beaten.
+
+   ShopGoodwill's sign-in and bid calls are the ones its own site makes (buyerapi.shopgoodwill.com: SignIn/Login with
+   the username and password AES-CBC encrypted by the site's public key, then ItemBid/PlaceBid with the Bearer token).
+   They are not a published API, so the bid's answer is kept (raw, cut short) on the snipe for the owner's test runs.
+   The seal key: SNIPE_SEAL_KEY (secret), else MEMBER_ID_SALT, else ADMIN_KEY. None set: connect is refused. */
+export const SGW_API_ROOT = "https://buyerapi.shopgoodwill.com/api/";
+const SGW_LOGIN_KEY = "6696D2E6F042FEC4D6E3F32AD541143B", SGW_LOGIN_IV = "0000000000000000";
+const SGW_HDR = {
+  "Accept": "application/json", "Origin": "https://shopgoodwill.com", "Referer": "https://shopgoodwill.com/",
+  "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
+};
+export const SNIPE_LEAD_MS = 6000;        /* the bid goes out this long before the close */
+export const SNIPE_WAKE_MS = 2500;        /* the alarm wakes this much earlier, to recheck the lot and warm the line */
+export const SNIPE_AHEAD_MS = 30000;      /* a snipe needs at least this long left when it is queued */
+export const SNIPE_CHECK_MS = 90000;      /* the final price is read this long after the close */
+export const SNIPE_MAX = 25;              /* queued at once, per member */
+const SNIPE_KEEP_MS = 14 * 86400000;      /* finished snipes are kept two weeks */
+const SNIPE_TIMEOUT_MS = 8000, RAW_MAX = 400, BODY_MAX = 4096;
+
+const enc = new TextEncoder();
+function b64(bytes) { let s = ""; for (let i = 0; i < bytes.length; i++) s += String.fromCharCode(bytes[i]); return btoa(s); }
+function b64u(bytes) { return b64(bytes).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""); }
+function unb64u(s) { return Uint8Array.from(atob(String(s).replace(/-/g, "+").replace(/_/g, "/")), c => c.charCodeAt(0)); }
+
+/* ShopGoodwill's sign-in form encrypts both fields with AES-CBC (PKCS7) under a key that ships in its own page,
+   then sends them base64 and URL-encoded. Not secrecy (the key is public), just the format its API expects. */
+export async function sgwEnc(v) {
+  const k = await crypto.subtle.importKey("raw", enc.encode(SGW_LOGIN_KEY), "AES-CBC", false, ["encrypt"]);
+  const c = new Uint8Array(await crypto.subtle.encrypt({ name: "AES-CBC", iv: enc.encode(SGW_LOGIN_IV) }, k, enc.encode(String(v))));
+  return encodeURIComponent(b64(c));
+}
+async function sgwFetch(f, path, init) {
+  const ctl = new AbortController(), timer = setTimeout(() => ctl.abort(), SNIPE_TIMEOUT_MS);
